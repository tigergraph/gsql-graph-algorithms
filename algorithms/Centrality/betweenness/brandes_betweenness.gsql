CREATE OR REPLACE QUERY brandes_betweenness(
    SET<STRING> v_type_set,
    SET<STRING> e_type_set,
    SET<STRING> reverse_e_type,
    INT max_hops = 10,
    INT top_k = 100,
    BOOL print_results = TRUE,
    STRING result_attribute = "",
    STRING file_path = "",
    BOOL display_edges = FALSE
) SYNTAX V1 {

    /*
    Repository:
        https://github.com/tigergraph/gsql-graph-algorithms/tree/master/algorithms/Centrality

    Maturity:
        Production

    Description: 
        Compute Betweenness Centrality for each VERTEX. 
        Use multi-source BFS.

    Default behavior matches:
        nx.betweenness_centrality(G, normalized=False, endpoints=False)

    Publications:
        http://www.vldb.org/pvldb/vol8/p449-then.pdf

    TigerGraph Documentation:
        https://docs.tigergraph.com/graph-ml/current/centrality-algorithms/betweenness-centrality

    Parameters:
        v_type_set:
            vertex types to traverse
        print_results:
            If True, print JSON output
        e_type_set:
            edge types to traverse
        result_attribute:
            INT attribute to store results to
        reverse_e_type:
            reverse edge type in directed graph, in undirected graph set reverse_e_type=e_type_set
        max_hops:
            look only this far from each vertex
        file_path:
            file to write CSV output to
        top_k:
            report only this many top scores
        display_edges:
            If True, output edges for visualization
      Graph semantics:
      - Undirected:
          pass the same edge type set for e_type_set and reverse_e_type
      - Directed:
          pass forward edge types in e_type_set
          pass ONLY reverse edge types in reverse_e_type
    */

    TYPEDEF TUPLE<VERTEX Vertex_ID, FLOAT score> Vertex_Score;

    HeapAccum<Vertex_Score>(top_k, score DESC) @@top_scores_heap;
    SetAccum<EDGE> @@edge_set;
    ListAccum<VERTEX> @@sources;

    // Final betweenness score
    SumAccum<FLOAT> @bc;

    // Per-source Brandes state
    SumAccum<INT> @dist;
    SumAccum<FLOAT> @sigma;
    SumAccum<FLOAT> @delta;

    FILE f(file_path);

    INT n;
    INT curr_dist;
    BOOL is_undirected = TRUE;

    all = {v_type_set};
    Start = all;
    Curr = all;

    n = all.size();

    // Determine whether the caller intends undirected semantics.
    // Convention:
    //   undirected => reverse_e_type == e_type_set
    //   directed   => reverse_e_type is the reverse-edge set only
    IF e_type_set.size() != reverse_e_type.size() THEN
        is_undirected = FALSE;
    END;

    FOREACH et IN reverse_e_type DO
        IF NOT e_type_set.contains(et) THEN
            is_undirected = FALSE;
        END;
    END;

    // Initialize final BC
    Start = SELECT v
            FROM all:v
            POST-ACCUM
                v.@bc = 0.0;

    // Materialize sources for query-body FOREACH
    @@sources.clear();
    Start = SELECT v
            FROM all:v
            POST-ACCUM
                @@sources += v;

    // ------------------------------------------------------------
    // Brandes outer loop: one source at a time
    // ------------------------------------------------------------
    FOREACH src IN @@sources DO

        // Reset per-source state
        Start = SELECT v
                FROM all:v
                POST-ACCUM
                    v.@dist = -1,
                    v.@sigma = 0.0,
                    v.@delta = 0.0;

        // Initialize source
        Start = SELECT v
                FROM all:v
                WHERE getvid(v) == getvid(src)
                POST-ACCUM
                    v.@dist = 0,
                    v.@sigma = 1.0;

        curr_dist = 0;

        // --------------------------------------------------------
        // Forward BFS
        // --------------------------------------------------------
        WHILE Start.size() > 0 LIMIT max_hops DO
            curr_dist = curr_dist + 1;

            IF is_undirected THEN
                Start = SELECT t
                        FROM Start:s -(e_type_set:e)- v_type_set:t
                        WHERE s != t AND t.@dist == -1
                        ACCUM
                            t.@sigma += s.@sigma
                        POST-ACCUM
                            t.@dist = curr_dist;
            ELSE
                Start = SELECT t
                        FROM Start:s -(e_type_set:e)-> v_type_set:t
                        WHERE s != t AND t.@dist == -1
                        ACCUM
                            t.@sigma += s.@sigma
                        POST-ACCUM
                            t.@dist = curr_dist;
            END;
        END;

        // We exit one layer past the deepest non-empty layer
        curr_dist = curr_dist - 1;

        // --------------------------------------------------------
        // Backward accumulation
        // Standard Brandes recurrence:
        //   delta[v] += (sigma[v] / sigma[w]) * (1 + delta[w])
        //   BC[w] += delta[w] for w != source
        // --------------------------------------------------------
        WHILE curr_dist > 0 DO

            Curr = SELECT w
                   FROM all:w
                   WHERE w.@dist == curr_dist;

            IF is_undirected THEN
                Start = SELECT v
                        FROM Curr:w -(e_type_set:e)- v_type_set:v
                        WHERE v.@dist == curr_dist - 1
                        ACCUM
                            FLOAT coeff = (1.0 + w.@delta) / w.@sigma,
                            v.@delta += v.@sigma * coeff;
            ELSE
                Start = SELECT v
                        FROM Curr:w -(reverse_e_type:e)-> v_type_set:v
                        WHERE v.@dist == curr_dist - 1
                        ACCUM
                            FLOAT coeff = (1.0 + w.@delta) / w.@sigma,
                            v.@delta += v.@sigma * coeff;
            END;

            Curr = SELECT w
                   FROM Curr:w
                   WHERE getvid(w) != getvid(src)
                   POST-ACCUM
                       w.@bc += w.@delta;

            curr_dist = curr_dist - 1;
        END;

    END;

    // ------------------------------------------------------------
    // Undirected correction
    // NetworkX/Brandes raw scores divide by 2 once at the end
    // ------------------------------------------------------------
    IF is_undirected THEN
        Start = SELECT v
                FROM all:v
                POST-ACCUM
                    v.@bc = v.@bc / 2.0;
    END;

    // ------------------------------------------------------------
    // Output
    // ------------------------------------------------------------
    IF file_path != "" THEN
        f.println("Vertex_ID", "Betweenness");
    END;

    Start = SELECT v
            FROM all:v
            POST-ACCUM
                IF result_attribute != "" THEN
                    v.setAttr(result_attribute, v.@bc)
                END,
                IF print_results THEN
                    @@top_scores_heap += Vertex_Score(v, v.@bc)
                END,
                IF file_path != "" THEN
                    f.println(v, v.@bc)
                END;

    IF print_results THEN
        PRINT @@top_scores_heap AS top_scores;

        IF display_edges THEN
            PRINT Start[Start.@bc];

            IF is_undirected THEN
                Start = SELECT s
                        FROM Start:s -(e_type_set:e)- :t
                        ACCUM
                            @@edge_set += e;
            ELSE
                Start = SELECT s
                        FROM Start:s -(e_type_set:e)-> :t
                        ACCUM
                            @@edge_set += e;
            END;

            PRINT @@edge_set;
        END;
    END;
}
