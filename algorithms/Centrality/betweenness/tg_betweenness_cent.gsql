CREATE QUERY tg_betweenness_cent(
    SET<STRING> v_type_set,
    SET<STRING> e_type_set,
    SET<STRING> reverse_e_type,
    INT max_hops = 10,
    INT top_k = 100,
    BOOL print_results = True,
    STRING result_attribute = "",
    STRING file_path = "",
    BOOL display_edges = FALSE
) SYNTAX V1 {
    
    /*
    Repository:
        https://github.com/tigergraph/gsql-graph-algorithms/tree/master/algorithms/Centrality

    Maturity:
        Production

    Description: 
        Compute Betweenness Centrality for each VERTEX. 
        Use multi-source BFS.

    Publications:
        http://www.vldb.org/pvldb/vol8/p449-then.pdf

    TigerGraph Documentation:
        https://docs.tigergraph.com/graph-ml/current/centrality-algorithms/betweenness-centrality

    Parameters:
        v_type_set:
            vertex types to traverse
        print_results:
            If True, print JSON output
        e_type_set:
            edge types to traverse
        result_attribute:
            name of attribute of type FLOAT / DOUBLE to store results to
        reverse_e_type:
            reverse edge type in directed graph, in undirected graph set reverse_e_type=e_type_set
        max_hops:
            look only this far from each vertex
        file_path:
            file to write CSV output to
        top_k:
            report only this many top scores
        display_edges:
            If True, output edges for visualization
    */

    TYPEDEF TUPLE<VERTEX Vertex_ID, FLOAT score> Vertex_Score;
    HeapAccum<Vertex_Score>(top_k, score DESC) @@top_scores_heap;
    SumAccum<INT> @@sum_curr_dist;
    BitwiseOrAccum @bitwise_or_visit_next;
    BitwiseOrAccum @bitwise_or_seen;
    BitwiseOrAccum @bitwise_or_visit;
    SumAccum<INT> @@sum_count = 1;
    SumAccum<INT> @sum_id;
    SetAccum<INT> @@batch_set;
    MapAccum<INT,INT> @@map;
    SetAccum<EDGE> @@edge_set;
    MapAccum<INT,BitwiseOrAccum> @times_map;
    MapAccum<INT,SumAccum<FLOAT>> @sigma;
    MapAccum<INT,SumAccum<FLOAT>> @sigma_next;
    MapAccum<INT,SumAccum<FLOAT>> @delta;
    MapAccum<INT,SumAccum<FLOAT>> @delta_next;
    SumAccum<FLOAT> @sum_cb = 0;

    INT empty=0;
    FILE f (file_path);
    INT num_vert;
    INT batch_number;
    BOOL is_undirected;

    all = {v_type_set};
    num_vert = all.size();
    batch_number = num_vert/60;
    is_undirected = (reverse_e_type == e_type_set);

    IF batch_number == 0 THEN
        batch_number = 1;
    END;

    FOREACH i IN RANGE[0, batch_number-1] DO
        Current = SELECT s
            FROM all:s
            WHERE getvid(s)%batch_number == i
            POST-ACCUM
                @@map+=(getvid(s)->0),
                @@batch_set+=getvid(s);

        FOREACH ver in @@batch_set DO
            @@map += (ver->@@sum_count); @@sum_count += 1;
        END;

        Start = SELECT s
            FROM Current:s
            POST-ACCUM
                s.@sum_id=@@map.get(getvid(s));

        Start = SELECT s
            FROM Current:s
            POST-ACCUM
                s.@bitwise_or_seen = 1<<s.@sum_id,
                s.@bitwise_or_visit = s.@bitwise_or_seen,
                s.@sigma += (s.@bitwise_or_seen -> 1),
                s.@times_map += (0->s.@bitwise_or_visit);

        @@batch_set.clear();
        @@map.clear();
        @@sum_count=0;

        # ── Forward BFS ──
        WHILE (Start.size() > 0) LIMIT max_hops DO
            @@sum_curr_dist+=1;

            Start = SELECT t
                FROM Start:s -(e_type_set:e)-v_type_set:t
                WHERE s.@bitwise_or_visit&-t.@bitwise_or_seen-1>0 AND s!=t
                ACCUM
                    INT c = s.@bitwise_or_visit&-t.@bitwise_or_seen-1,
                    IF c>0 THEN
                        t.@bitwise_or_visit_next+=c,
                        t.@bitwise_or_seen+=c,
                        INT r = c,
                        WHILE r > 0 DO
                            INT b = r & (-r),
                            t.@sigma_next += (b -> s.@sigma.get(b)),
                            r = r & (r-1)
                        END
                    END
                POST-ACCUM
                    t.@bitwise_or_visit=t.@bitwise_or_visit_next,
                    t.@times_map+=(@@sum_curr_dist->t.@bitwise_or_visit),
                    t.@bitwise_or_visit_next=0,
                    FOREACH (b, val) IN t.@sigma_next DO
                        t.@sigma += (b -> val)
                    END,
                    t.@sigma_next.clear();
        END;

        # ── Backward accumulation ──
        @@sum_curr_dist+=-1;

        Start = SELECT s
            FROM all:s
            WHERE s.@times_map.get(@@sum_curr_dist)!=0;

        WHILE (Start.size()>0) LIMIT max_hops DO
            @@sum_curr_dist+=-1;
            Start = SELECT t
                FROM Start:s -(reverse_e_type:e)- v_type_set:t
                WHERE t.@times_map.get(@@sum_curr_dist)&s.@times_map.get(@@sum_curr_dist+1)!=0
                ACCUM
                    INT shared = t.@times_map.get(@@sum_curr_dist)&s.@times_map.get(@@sum_curr_dist+1),
                    WHILE shared > 0 DO
                        INT b = shared & (-shared),
                        FLOAT sig_v = t.@sigma.get(b),
                        FLOAT sig_w = s.@sigma.get(b),
                        IF sig_w > 0 THEN
                            t.@delta_next += (b -> (sig_v / sig_w) * (1 + s.@delta.get(b)))
                        END,
                        shared = shared & (shared - 1)
                    END;

            # Apply staged delta and select next frontier in one pass
            Start = SELECT s
                FROM all:s
                WHERE s.@times_map.get(@@sum_curr_dist)!=0
                POST-ACCUM
                    FOREACH (b, val) IN s.@delta_next DO
                        s.@delta += (b -> val)
                    END,
                    s.@delta_next.clear();
        END;

        # ── Accumulate C_B and clear for next batch ──
        @@sum_curr_dist=0;
        Start = SELECT s
            FROM all:s
            POST-ACCUM
                INT own = s.@times_map.get(0),
                FOREACH (b, val) IN s.@delta DO
                    IF (b & own) == 0 THEN
                        s.@sum_cb += val
                    END
                END,
                s.@bitwise_or_seen=0,
                s.@bitwise_or_visit=0,
                s.@sigma.clear(),
                s.@delta.clear(),
                s.@sigma_next.clear(),
                s.@delta_next.clear(),

                s.@times_map.clear();
    END;

    IF is_undirected THEN
        Start = SELECT s
            FROM all:s
            POST-ACCUM
                s.@sum_cb = s.@sum_cb / 2.0;
    END;

    IF file_path != "" THEN
        f.println("Vertex_ID", "Betweenness");
    END;

    Start = SELECT s
        FROM all:s
        POST-ACCUM
            IF result_attribute != "" THEN
                s.setAttr(result_attribute, s.@sum_cb)
            END,

            IF print_results THEN
                @@top_scores_heap += Vertex_Score(s, s.@sum_cb)
            END,

            IF file_path != "" THEN
                f.println(s, s.@sum_cb)
            END;

    IF print_results THEN
        PRINT @@top_scores_heap AS top_scores;

        IF display_edges THEN
            PRINT Start[Start.@sum_cb];

            Start = SELECT s
                FROM Start:s -(e_type_set:e)-:t
                ACCUM
                    @@edge_set += e;

            PRINT @@edge_set;

        END;
    END;

}
